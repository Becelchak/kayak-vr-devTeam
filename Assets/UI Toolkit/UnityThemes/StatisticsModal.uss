.screen-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px) position absolute;
    left: 0;
    top: 0;
}

.modal-window {
    background-color: rgb(255, 255, 255);
    border-radius: 25px;
    width: 650px;
    height: 595px;
    overflow: hidden;
    padding-bottom: 20px;
}

.modal-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding-top: 25px;
    padding-bottom: 25px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(224, 224, 224);
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 25px;
}

.bg-light {
    background-color: rgba(255, 255, 255, 0.8);
}

.bg-dark {
    background-color: rgba(235, 235, 235, 0.7);
}

.stat-label {
    font-size: 25px;
    color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
}

.stat-value {
    font-size: 25px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-right;
}

.button-container {
    padding: 15px 20px 10px 20px;
    justify-content: center;
    align-items: center;
}

.close-button {
    font-size: 16px;
    padding: 8px 20px;
    border-radius: 8px;
    border-width: 0;
}

.close-button:hover {
}
