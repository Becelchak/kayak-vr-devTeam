/* Основные стили */
.root {
    flex-grow: 1;
    position: relative;
    flex-direction: column;
    font-size: 18px;
    color: rgb(20, 20, 20);
}

/* ФОН через CSS */
.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Images/bg_menu_kayak.png");
    background-size: cover;
    background-position: center;
}

/* Верхняя панель */
.top-bar {
    height: 90px;
    padding-left: 240px;
    padding-right: 240px;
    border-radius: 20px;
    background-color: rgba(217, 217, 217, 0.8);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.header-title {
    font-family: "Roboto";
    -unity-font-weight: 500;
    font-size: 34px;
    -unity-line-height: 1.0;  /* 100% = 1.0 */
    margin-bottom: 14px;      /* paragraph spacing */
    letter-spacing: 0px;
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
}

.top-icons {
    flex-direction: row;
}

/* ИКОНКИ через CSS (скрываем старый текст) */
#settings-button .icon-text,
#profile-button .icon-text {
    width: 0;
    height: 0;
    display: none;
}

#settings-button {
    width: 50px;
    height: 50px;
    margin-left: 12px;
    border: none;
    background-image: url("project://database/Assets/UI/Icons/settings_play.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

#profile-button {
    width: 50px;
    height: 50px;
    margin-left: 24px;
    border-radius: 28px;
    background-color: rgba(255, 255, 255, 0.2);
    background-image: url("project://database/Assets/UI/Icons/account_play.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* Основной контент */
.content {
    flex-grow: 1;
    margin: 40px auto 60px;
    flex-direction: row;
    justify-content: center;
}

.glass {
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 28px;
    padding: 24px;
}

.left-panel {
    width: 45%;
    height: 100%;
    border-radius: 10px;
    margin-right: 24px;
}

.panel-title {
    font-family: "Roboto";
    -unity-font-weight: 500;
    font-size: 34px;
    -unity-line-height: 1.0;  /* 100% = 1.0 */
    margin-bottom: 14px;      /* paragraph spacing */
    letter-spacing: 0px;
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
    margin-bottom: 26px;
}

/* Карусель */
.slider-container {
    height: 426px;
    width: 100%;
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
}

.route-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/UI/Images/route1.png");
    background-size: cover;
    background-position: center;
    margin-bottom: 26px; 
}

.slider-arrow {
    position: absolute;
    top: 50%;
    width: 20px;
    height: 20px;
}

.slider-arrow Label {
    display: none;
}

.left-arrow {
    left: 5px;
    background-image: url("project://database/Assets/UI/Icons/LeftArrow.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* Стрелка вправо */
.right-arrow {
    right: 5px;
    background-image: url("project://database/Assets/UI/Icons/RightArrow.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* Пагинация */
.pagination {
    position: absolute;
    bottom: 15px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(197, 197, 197, 1);
    margin-left: 4px;
    margin-right: 4px;
}

.active {
    background-color: rgba(24, 24, 24, 1);
}

/* Описание */
.description-title {
    font-family: "Roboto";
    -unity-font-weight: 500;
    font-size: 25px;
    -unity-line-height: 1.0;  /* 100% = 1.0 */
    margin-bottom: 14px;      /* paragraph spacing */
    letter-spacing: 0px;
    color: rgb(0, 0, 0);
    -unity-font-style: medium;
}

.description-text {
    font-family: "Roboto";
    -unity-font-weight: 500;
    font-size: 16px;
    -unity-line-height: 1.0;  /* 100% = 1.0 */
    letter-spacing: 0px;
    color: rgb(0, 0, 0);
    -unity-font-style: regular;

    margin-bottom: 16px;
    white-space: normal;
}

/* Кнопка старта */
.start-button {
    height: 55px;
    margin-top: 22px;
    border-radius: 10px;
    background-color: rgba(12, 74, 0, 0.7);
    color: white;
    font-size: 25px;
    -unity-font-weight: 400;
    -unity-font-style: medium;
}

/* Правая колонка */
.right-column {
    width: 35%;
    flex-direction: column;
}

.stats-panel {
    padding: 24px 0;
    height: 42%;
    margin-bottom: 24px;
}

.chart-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.chart-area {
    flex-grow: 1;
    height: 180px;
    margin-left: 12px;
    margin-right: 12px;
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.chart-arrow {
    width: 20px;
    height: 20px;
}

.chart-arrow-left {
    left: 5px;
    background-image: url("project://database/Assets/UI/Icons/LeftArrowDark.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.chart-arrow-right {
    right: 5px;
    background-image: url("project://database/Assets/UI/Icons/RightArrowDark.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.stats-name {
    font-family: "Roboto";
    -unity-font-weight: 500;
    font-size: 25px;
    -unity-line-height: 1.0;  /* 100% = 1.0 */
    letter-spacing: 0px;
    color: rgb(0, 0, 0);
    -unity-font-style: medium;

    margin-top: 12px;
    margin-left: 24px;
}

/* Таблица рекордов */
.rating-panel {
    padding: 24px 0;
    flex-grow: 1;
}

.rating-title {
    font-family: "Roboto";
    -unity-font-weight: 500;
    font-size: 34px;
    -unity-line-height: 1.0;  /* 100% = 1.0 */
    letter-spacing: 0px;
    color: rgb(0, 0, 0);
    -unity-font-style: medium;
    margin-bottom: 26px;
    margin-left: 30px;
}

.rating-list {
    flex-grow: 1;
}

.rating-row {
    font-family: "Roboto";
    -unity-font-weight: 300;
    font-size: 25px;
    -unity-line-height: 1.4;  /* 100% = 1.0 */
    letter-spacing: 0px;
    color: rgb(0, 0, 0);
    -unity-font-style: light;

    height: 70px;
    margin-bottom: 15px;
    padding-left: 25px;
    padding-right: 25px;
    background-color: rgba(235, 235, 235, 0.7);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.active-row {
    color: rgb(76, 115, 56);
}

.table-button {
    height: 55px;
    margin: 25px auto 0;
    border-radius: 10px;
    background-color: rgb(87, 101, 185);
    color: white;
    font-size: 25px;
    color: white;
    font-size: 25px;
    -unity-font-weight: 400;
    -unity-font-style: medium;
    width: 92%;
}