  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0422\u0440\u0430\u0441\u0441\u0430 \"\u0411\u0435\u0440\u0451\u0437\u043E\u0432\u0430\u044F
    \u0420\u043E\u0449\u0430\" \u2014 8 \u043A\u043C \u043F\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u043C\u0443
    \u0442\u0435\u0447\u0435\u043D\u0438\u044E \u0441 \u043F\u043E\u0440\u043E\u0433\u0430\u043C\u0438
    I\u2013II; \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
    \u0431\u0435\u0440\u0451\u0437\u043E\u0432\u044B\u0435 \u043B\u0435\u0441\u0430
    \u0438 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u043D\u044B\u0435 \u0437\u0430\u043B\u0438\u0432\u044B.
    \u0412\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    3\u20134 \u0447\u0430\u0441\u0430. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u0434\u043B\u044F \u043A\u0430\u044F\u043A\u0435\u0440\u043E\u0432 \u0441\u043E
    \u0441\u0440\u0435\u0434\u043D\u0438\u043C \u043E\u043F\u044B\u0442\u043E\u043C;
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B \u0441\u043F\u0430\u0441\u0436\u0438\u043B\u0435\u0442
    \u0438 \u0448\u043B\u0435\u043C. \u0421\u0442\u0430\u0440\u0442 \u2014 \u043F\u0440\u0438\u0447\u0430\u043B
    \"\u0421\u0442\u0430\u0440\u044B\u0439 \u043C\u043E\u0441\u0442\", \u0444\u0438\u043D\u0438\u0448
    \u2014 \"\u041B\u0435\u0441\u043D\u0430\u044F \u043F\u043E\u043B\u044F\u043D\u0430\".
    \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438: \u043C\u0435\u043B\u043A\u043E\u0432\u043E\u0434\u044C\u0435,
    \u043D\u0430\u0432\u0438\u0441\u0430\u044E\u0449\u0438\u0435 \u0432\u0435\u0442\u0432\u0438,
    \u043A\u0430\u043C\u043D\u0438."
